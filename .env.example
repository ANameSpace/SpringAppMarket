# Copy this file to .env and replace every "change-me" value.
# The real .env is ignored by git and must never be committed.

# PostgreSQL
# user-service uses its own database. app-service, order-service and
# review-service each use a separate database; create them once on the server:
#   CREATE DATABASE app_db;
#   CREATE DATABASE order_db;
#   CREATE DATABASE review_db;
DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/user_db
APP_DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/app_db
ORDER_DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/order_db
REVIEW_DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/review_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me

# OAuth2 clients (gateway-server and Grafana)
GATEWAY_CLIENT_SECRET=change-me
GRAFANA_CLIENT_SECRET=change-me

# Garage S3 (file storage for app-service)
# GARAGE_RPC_SECRET must be a 32-byte hex string (64 hex characters).
# S3_ACCESS_KEY / S3_SECRET_KEY are imported into Garage by garage-init and are
# also used by app-service to sign requests.
GARAGE_RPC_SECRET=change-me-64-hex-characters
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=app-market
S3_REGION=garage
S3_PUBLIC_ENDPOINT=http://localhost:3900

# user-service admin user (seeded into PostgreSQL)
APP_USER_NAME=admin
APP_USER_PASSWORD=change-me

# Grafana
# The bootstrap admin is created only on the first startup of an empty
# grafana_data volume. Its login must differ from every user-service login:
# an OAuth user cannot be created when a local user with the same login exists.
# Basic authentication and the login form are disabled, so this account is not
# reachable through the gateway.
# GRAFANA_ADMIN_PASSWORD is applied only when the Grafana database is
# initialized for the first time. For an existing grafana_data volume, change
# the password in the Grafana UI or reset the volume.
GRAFANA_ADMIN_USER=grafana-bootstrap
GRAFANA_ADMIN_PASSWORD=change-me
